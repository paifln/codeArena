# Copy to .env only when changing defaults. Never put credentials here.
BIND_HOST=0.0.0.0
PORT=8000
# true only behind HTTPS; plain HTTP LAN development needs false.
COOKIE_SECURE=false
RUN_COOLDOWN_SECONDS=2
SUBMIT_COOLDOWN_SECONDS=5
MAX_QUEUE_SIZE=200
# Same-origin UI needs no CORS. Optional explicit comma-separated origins.
ALLOWED_ORIGINS=
# Docker Desktop commonly uses 0. Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0
