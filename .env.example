# Copy to .env and generate SECRET_KEY before starting. Never commit .env.
SECRET_KEY=
BIND_HOST=0.0.0.0
PORT=8000
# true only behind HTTPS; plain HTTP LAN development needs false.
COOKIE_SECURE=false
RUN_COOLDOWN_SECONDS=2
SUBMIT_COOLDOWN_SECONDS=5
MAX_QUEUE_SIZE=200
# Same-origin UI needs no CORS. Optional explicit comma-separated origins.
ALLOWED_ORIGINS=
# Docker Desktop commonly uses 0. Linux: stat -c %g /var/run/docker.sock
DOCKER_GID=0

# Bounded parallel judging within one worker process (1-4).
JUDGE_CONCURRENCY=2
BACKUP_INTERVAL_SECONDS=21600
BACKUP_KEEP=28
