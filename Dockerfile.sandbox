FROM python:3.12-slim-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends g++ openjdk-17-jdk-headless && rm -rf /var/lib/apt/lists/*
COPY backend/judge/bootstrap.py /opt/codearena/bootstrap.py
USER 10001:10001
WORKDIR /tmp
ENTRYPOINT ["python", "-I", "-B", "/opt/codearena/bootstrap.py"]
